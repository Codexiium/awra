# Copy this file to .env.local and fill in real values from your Supabase
# project dashboard (Project Settings -> API Keys, and Project Settings ->
# Database -> Connection string). Never commit .env.local — it's gitignored.

# Project Settings -> API Keys -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> anon / publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Project Settings -> API Keys -> secret key (server-only — bypasses RLS, never expose to the client)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Project Settings -> Database -> Connection string -> URI -> "Direct connection" tab.
# Used locally to run migrations (psql -f supabase/migrations/*.sql) and the
# one-off seed script (scripts/seed.ts) — not read by the app itself at runtime.
# The password in this URL must be percent-encoded if it contains special
# characters (e.g. "@" -> "%40").
SUPABASE_DB_DIRECT_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Project Settings -> Database -> Connection string -> URI -> "Transaction pooler" tab.
# Not currently used by this app (it talks to Supabase via supabase-js/PostgREST,
# not a raw Postgres driver) — kept here for reference/future use.
SUPABASE_DB_TRANSACTIONAL_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# The site's own public origin — used for metadataBase and for email-
# confirmation/password-reset redirect links generated outside a request.
# Optional: falls back to the incoming request's own host when unset, which
# is fine for redirect links but not for metadataBase (a static, build-time
# value), so set this for any real deployment.
NEXT_PUBLIC_SITE_URL=https://arwa.example

# Project Settings -> Auth -> SMTP Settings — the same SMTP credentials
# already configured there for Supabase's own auth emails. lib/email/'s
# "supabase-smtp" provider (see TODO.md for the planned swap to Resend) sends
# order confirmation, shipping notification, and contact-form emails
# directly over SMTP using these.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=ARWA <no-reply@arwa.example>

# Where the "new order placed" alert and contact-form messages are sent.
STORE_NOTIFICATION_EMAIL=orders@arwa.example
